{
  "name": "compass-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "deploy": "wrangler deploy",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "smoke:remote": "tsx test/remote-smoke.ts",
    "smoke:worker": "tsx test/worker-smoke.ts",
    "verify:remote": "tsx test/remote-source.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.1.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "wrangler": "4.125.0"
  }
}
